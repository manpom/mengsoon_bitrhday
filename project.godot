; Engine configuration file.
; 「맹꽁의 기억」 프로젝트 설정
;
; 이 파일은 Godot이 "여기가 프로젝트 루트다"라고 인식하는 유일한 파일입니다.
; Godot 에디터에서 [프로젝트 가져오기] -> 이 폴더 선택 으로 열 수 있습니다.
; 대부분의 값은 에디터의 [프로젝트] > [프로젝트 설정] 에서도 바꿀 수 있습니다.

config_version=5

[application]

config/name="맹꽁의 기억"
config/description="미니게임을 클리어하며 추억을 되찾는 커플 게임 (프로토타입 단계)"
run/main_scene="res://scenes/levels/prototype_room.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

; 게임의 "기준 해상도". 실제 창/브라우저 크기가 달라도 이 크기로 그린 뒤 늘려줍니다.
window/size/viewport_width=480
window/size/viewport_height=270
; viewport = 저해상도로 그린 화면을 통째로 확대 -> 픽셀아트에 적합
window/stretch/mode="viewport"
; expand = 아이폰처럼 화면 비율이 다르면 여백 대신 시야를 조금 더 보여줌
window/stretch/aspect="expand"

[input]

move_left={
